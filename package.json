{
  "name": "pixelforge-studio",
  "version": "1.0.0",
  "description": "Original desktop image editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.pixelforge.app",
    "productName": "PixelForge Studio",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "styles.css"],
    "win": { "target": "nsis", "artifactName": "PixelForge-Studio-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}